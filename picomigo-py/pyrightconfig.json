{
  "include": [
    "src",
    "tests"
  ],

  "exclude": [
    "src/picomigo/serial.py"
  ],

  "typeCheckingMode": "recommended",

  "allowedUntypedLibraries": [
      "neopixel2",
      "rotary_encoder"
  ],

  "reportAny": false,
  "reportExplicitAny": false,

  "executionEnvironments": [
    {
      "root": "src/picomigo/pico",
      "reportMissingModuleSource": false,
      "reportMissingTypeStubs": false,
    },
    {
      "root": "src/picomigo/examples",
      "reportMissingModuleSource": false,
      "reportMissingTypeStubs": false,
    },
    {
      "root": "src/picomigo/tests",
      "reportMissingModuleSource": false,
      "reportMissingTypeStubs": false,
    },
    {
      "root": "lib",
      "reportMissingModuleSource": false,
      "reportMissingTypeStubs": false,
    }
  ],

  "pythonVersion": "3.13",
  "pythonPlatform": "Linux",
}

#!/bin/sh

set -eu

send() {
    msg=$(jq -n "$@")

    request "$msg"
}

send_raw() {
    msg=$(echo "$@" | jq)

    request "$msg"
}

request () {
    msg="$1"

    request=$(printf "%s\r\n\r\n%s" "Content-Length: ${#msg}" "$msg")

    printf "$request" > request.json

    # echo "request: $request"

    printf "$request"

    # cat "$request" >> clang_fifo
}


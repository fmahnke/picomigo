#!/bin/sh

set -eu

dry_run="${1:-0}"

build_dir=_build
lib_dir="$build_dir/lib"

if [ "$dry_run" = -n ]; then
    dry_run='--dry-run'
else
    dry_run=
fi

do_build_rsync () {
    name="$1"

    shift

    printf "\n--- build $name... ---\n\n"

    rsync $dry_run --progress --delete  --exclude='__pycache__' "$@"
}

mkdir -p "$build_dir" "$lib_dir"

do_build_rsync pico \
    -avzr \
    --exclude='examples' --exclude='lib' \
    src/picomigo/pico/ \
    _build

do_build_rsync logging \
    -avzr \
    lib/micropython_logging/micropython_logging.py _build/lib

do_build_rsync ssd1306 \
    -avzr \
    lib/ssd1306/ssd1306.py _build/lib

do_build_rsync st7789py \
    -avzr \
    lib/st7789py_mpy/lib/st7789py.py _build/lib/st7789py.py

do_build_rsync st7789py \
    -avzr \
    lib/st7789py_mpy/romfonts/vga2_16x32.py _build/lib/vga2_16x32.py

do_build_rsync neopixel \
    -avzr \
    lib/pi_pico_neopixel/neopixel.py _build/lib/neopixel2.py

do_build_rsync rotary_encoder \
    -avzr \
    lib/micropython_rotary_encoder/micropython_rotary_encoder/ _build/lib/rotary_encoder

do_build_rsync typing \
    -avzr \
    lib/typing/* _build/lib

printf "\n--- install to board... ---\n\n"

rshell -f rshell_build

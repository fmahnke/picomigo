#!/bin/sh

set -eu

dry_run="${1:-0}"

build_dir=_build
lib_dir="$build_dir/lib"

if [ "$dry_run" = -n ]; then
    dry_run='--dry-run'
else
    dry_run=
fi

do_build_rsync () {
    name="$1"

    shift

    printf "\n--- build $name... ---\n\n"

    rsync $dry_run --progress --delete  --exclude='__pycache__' "$@"
}

mkdir -p "$build_dir" "$lib_dir"

do_build_rsync pico \
    -avzr \
    --exclude='examples' --exclude='lib' \
    src/picomigo/pico/ \
    _build

do_build_rsync tests \
    -avzr \
    src/picomigo/tests/* _build/tests

do_build_rsync lib \
    -avzr \
    lib/argparse.mpy lib/fnmatch.mpy _build/lib

do_build_rsync collections \
    -avzr \
    lib/collections/collections _build/lib

do_build_rsync inspect \
    -avzr \
    lib/inspect/inspect.mpy _build/lib

do_build_rsync logging \
    -avzr \
    lib/micropython_logging/micropython_logging.py _build/lib

do_build_rsync mcp23017 \
    -avzr \
    lib/micropython-mcp23017/mcp23017.py _build/lib

do_build_rsync unittest \
    -avzr \
    lib/unittest/unittest/__init__.py \
    lib/unittest/unittest/__main__.py \
    lib/unittest/unittest/discover.py \
    _build/lib/unittest

do_build_rsync blinker \
    -avzr \
    lib/blinker/blinker _build/lib

do_build_rsync umsgpack \
    -avzr \
    lib/umsgpack/umsgpack _build/lib

# do_build_rsync ssd1306 \
#     -avzr \
#     lib/ssd1306/ssd1306.py _build/lib

# do_build_rsync st7789py \
#     -avzr \
#     lib/st7789py_mpy/lib/st7789py.py _build/lib/st7789py.py
# 
# do_build_rsync st7789py \
#     -avzr \
#     lib/st7789py_mpy/romfonts/vga2_16x32.py _build/lib/vga2_16x32.py

do_build_rsync neopixel \
    -avzr \
    lib/pi_pico_neopixel/neopixel.py _build/lib/neopixel2.py

do_build_rsync rotary_encoder \
    -avzr \
    lib/micropython_rotary_encoder/micropython_rotary_encoder/ _build/lib/rotary_encoder

do_build_rsync vl53l0x \
    -avzr \
    lib/vl53l0x/vl53l0x.py _build/lib/vl53l0x.py

do_build_rsync typing \
    -avzr \
    lib/typing/* _build/lib

printf "\n--- install to board... ---\n\n"

rshell -f rshell_build
